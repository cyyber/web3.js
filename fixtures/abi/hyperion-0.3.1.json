		"sources": {
			"AbiCompatibility.hyp": {
				"content": "// SPDX-License-Identifier: LGPL-3.0\npragma hyperion 0.3.1;\n\ninterface CallbackTarget {\n    function ping() external;\n}\n\ncontract AbiCompatibility {\n    struct Bundle {\n        function() external callback;\n        bytes payload;\n    }\n\n    error Custom(uint code, address who, string note);\n\n    event Indexed(address indexed who, bytes64 indexed wide, uint indexed id, int value, string note);\n\n    uint256[] public narrowValues;\n    mapping(address => uint) public balances;\n    mapping(bytes64 => mapping(uint => bool)) public wideKeys;\n\n    function pointer() private pure returns (function() external) {\n        return CallbackTarget(account()).ping;\n    }\n\n    function account() private pure returns (address) {\n        return address(uint512(\n            0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n        ));\n    }\n\n    function wide() private pure returns (bytes64) {\n        return bytes64(uint512(\n            0xfedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210\n        ));\n    }\n\n    function aliases() external pure returns (bytes memory) {\n        return abi.encode(type(uint).max, type(int).min);\n    }\n\n    function narrowIntegers() external pure returns (bytes memory) {\n        return abi.encode(type(uint256).max, type(int256).min);\n    }\n\n    function wideIntegers() external pure returns (bytes memory) {\n        return abi.encode(uint512(1) << 400, -(int512(1) << 400));\n    }\n\n    function functionAndString() external pure returns (bytes memory) {\n        return abi.encode(pointer(), uint(7), \"hello\");\n    }\n\n    function fixedFunctions() external pure returns (bytes memory) {\n        function() external[2] memory callbacks = [pointer(), pointer()];\n        return abi.encode(callbacks, uint(9));\n    }\n\n    function dynamicFunctions() external pure returns (bytes memory) {\n        function() external[] memory callbacks = new function() external[](2);\n        callbacks[0] = pointer();\n        callbacks[1] = pointer();\n        return abi.encode(callbacks, uint(9));\n    }\n\n    function nestedFunction() external pure returns (bytes memory) {\n        return abi.encode(Bundle(pointer(), hex\"010203\"), uint(9));\n    }\n\n    function packed() external pure returns (bytes memory) {\n        return abi.encodePacked(uint(1), int(-2), pointer());\n    }\n\n    function packedNarrow() external pure returns (bytes memory) {\n        return abi.encodePacked(uint256(1), int256(-2), account(), wide());\n    }\n\n    function packedFunctions() external pure returns (bytes memory) {\n        function() external[2] memory callbacks = [pointer(), pointer()];\n        return abi.encodePacked(callbacks);\n    }\n\n    function packedIntegers() external pure returns (bytes memory) {\n        uint[2] memory unsigned = [uint(1), type(uint).max];\n        int[2] memory signed = [int(-2), type(int).min];\n        return abi.encodePacked(unsigned, signed);\n    }\n\n    // Echoes its arguments, so that an SDK's selector and argument encoding is\n    // checked against the compiler's decoder.\n    function echo(uint a, int b, uint256 c, address d, bytes64 e, string calldata f)\n        external\n        pure\n        returns (bytes memory)\n    {\n        return abi.encode(a, b, c, d, e, f);\n    }\n\n    function emitIndexed() external {\n        emit Indexed(account(), wide(), type(uint).max, -2, \"hello\");\n    }\n\n    function revertCustom() external pure {\n        revert Custom(type(uint).max, account(), \"hello\");\n    }\n\n    function revertString() external pure {\n        revert(\"hello\");\n    }\n\n    function panicAssert() external pure {\n        assert(false);\n    }\n\n    function panicDivision() external pure returns (uint) {\n        uint zero;\n        return 1 / zero;\n    }\n\n    function panicIndex() external view returns (uint256) {\n        return narrowValues[0];\n    }\n}\n"
			}
		}
	},
